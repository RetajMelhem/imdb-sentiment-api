# Docker Compose works without an .env file and uses the bundled /opt/model.
PORT=8080

# For Python development outside Docker, download the model with:
# python scripts/download_model.py
MODEL_PATH=./model
# Alternatively, unset MODEL_PATH and configure both MODEL_ID and HF_REVISION:
# MODEL_ID=retaj249/imdb-deberta-v3-sentiment
# HF_REVISION=0cadd57a4ea34183f3cd4f14f2902a06cf73ac5e

DEVICE=auto
MAX_BATCH_SIZE=32
MAX_TEXT_CHARS=100000
MAX_REQUEST_BYTES=4194304
LOG_LEVEL=INFO
HF_HOME=.cache/huggingface
MAX_CONCURRENT_INFERENCES=1
INFERENCE_QUEUE_TIMEOUT_SECONDS=5

# Optional behavior overrides. Leave unset to use model_metadata.json.
# MAX_LENGTH=384
# DECISION_THRESHOLD=0.477
# INFERENCE_BATCH_SIZE=8
