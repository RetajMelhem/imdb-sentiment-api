# Choose exactly one fine-tuned model source. MODEL_PATH takes precedence.
MODEL_PATH=./model
# MODEL_ID=your-hf-username/imdb-deberta-v3-base-sentiment
# HF_REVISION=0123456789abcdef0123456789abcdef01234567

DEVICE=auto
MAX_BATCH_SIZE=32
MAX_TEXT_CHARS=100000
MAX_REQUEST_BYTES=4194304
LOG_LEVEL=INFO
HF_HOME=.cache/huggingface
MAX_CONCURRENT_INFERENCES=1
INFERENCE_QUEUE_TIMEOUT_SECONDS=5

# Optional behavior overrides. Leave unset to use model_metadata.json.
# MAX_LENGTH=384
# DECISION_THRESHOLD=0.477
# INFERENCE_BATCH_SIZE=8
